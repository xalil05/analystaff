# Copier ce fichier vers .env et remplir les valeurs.
# .env n'est JAMAIS commité (voir .gitignore).

# --- Application ---
APP_ENV=development
DEBUG=true
TIMEZONE=Africa/Dakar

# --- Base de données ---
# En dev local hors Docker : localhost. En Docker, surchargé par docker-compose.
DATABASE_URL=postgresql+asyncpg://analystaff:analystaff@localhost:5432/analystaff
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_ECHO=false

# --- Sécurité ---
# À générer : openssl rand -hex 32
SECRET_KEY=change-me-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (origine du frontend) ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Stockage fichiers ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- IA (DeepSeek) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- PostgreSQL (utilisé par docker-compose) ---
POSTGRES_USER=analystaff
POSTGRES_PASSWORD=analystaff
POSTGRES_DB=analystaff

# --- Stockage objet MinIO (évolution de ZG-2) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=analystaff
MINIO_SECRET_KEY=analystaff_minio_secret
MINIO_BUCKET=analystaff-files
MINIO_SECURE=false